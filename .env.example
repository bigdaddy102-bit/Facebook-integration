# Facebook/Instagram (Meta) App – https://developers.facebook.com/apps
FACEBOOK_APP_ID=
FACEBOOK_APP_SECRET=
FACEBOOK_PAGE_ID=
FACEBOOK_PAGE_ACCESS_TOKEN=
FACEBOOK_API_VERSION=v21.0

# Webhook-Verifizierung (frei wählbarer String, im Meta App Dashboard identisch eintragen)
FACEBOOK_WEBHOOK_VERIFY_TOKEN=

# Meta Commerce Catalog (Facebook/Instagram Shop) für den Produktsync
FACEBOOK_CATALOG_ID=

# Shopify Admin API (Quelle: www.noverah.de)
# Domain OHNE https://, z.B. "1t5gip-kh.myshopify.com"
SHOPIFY_STORE_DOMAIN=
SHOPIFY_ADMIN_API_TOKEN=
SHOPIFY_API_VERSION=2024-10

# Server
PORT=3000
NODE_ENV=development
